GEMINI_API_KEY=paste-your-key-here
# Matches docker-compose.yml. Change for your own Postgres.
DATABASE_URL=postgresql+psycopg://recipe:recipe@localhost:5433/recipecart
# Optional: require this token (X-Admin-Token) to edit the catalogue.
# ADMIN_TOKEN=change-me

# --- Reel media (optional) ---
# Download a reel's audio/video from its link with yt-dlp. UNOFFICIAL: Instagram's terms
# forbid automated downloading, it often needs a login (no cookies are ever sent) and it
# breaks when Instagram changes. Off by default; uploads and pasting always work.
VIDEO_DOWNLOAD=0
# If a reel's audio has no recipe (silent reels with text overlays), try the video too.
VIDEO_FALLBACK=1
MAX_VIDEO_MB=100
MAX_VIDEO_SECONDS=180
# Beta guard: media jobs per day across all users (in-memory, per process).
VIDEO_MAX_PER_DAY=30
